rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }

    match /products/{document=**} { allow read: if true; allow write: if false; }
    match /productVariants/{document=**} { allow read: if true; allow write: if false; }
    match /providers/{document=**} { allow read, write: if false; }
    match /users/{userId} {
      function customerFields() { return ["displayName", "phone", "email", "marketingConsent", "addresses", "photoURL", "privacyRequest", "createdAt", "updatedAt"]; }
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(customerFields())
        && (!request.resource.data.keys().hasAny(["addresses"]) || request.resource.data.addresses.size() <= 10);
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(customerFields())
        && (!request.resource.data.keys().hasAny(["addresses"]) || request.resource.data.addresses.size() <= 10);
      allow delete: if false;
    }
    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
    match /productReviews/{reviewId} {
      allow read, write: if false;
    }
  }
}
