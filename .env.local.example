# Public canonical storefront origin used by metadata, sitemap and structured data
NEXT_PUBLIC_SITE_URL=https://weartherisk.com

# Firebase Console > Project settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: only needed if Analytics is enabled
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Console > Project settings > Service accounts > Firebase Admin SDK
# Download the service account JSON privately; never commit it or prefix these with NEXT_PUBLIC_.
# Map JSON project_id, client_email and private_key to the variables below.
# Quote FIREBASE_PRIVATE_KEY and preserve its escaped \n line breaks.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Printify server-only credentials (never prefix these with NEXT_PUBLIC_)
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
# Shared HMAC secret used by Printify webhook subscriptions.
PRINTIFY_WEBHOOK_SECRET=

# Stripe server-only credentials. Rotate exposed keys before adding them here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
